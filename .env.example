APP_NAME=Micromega Inmobiliaria
APP_ENV=dev

# Arranque inmediato, sin instalar PostgreSQL:
DATABASE_URL=sqlite:///./micromega.db
# Para PostgreSQL con docker-compose:
# DATABASE_URL=postgresql+psycopg://micromega:micromega@localhost:5432/micromega

# LLM
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# WhatsApp Cloud API / Meta
# El token de verificación lo elegimos nosotros y debe coincidir con el configurado en Meta.
WHATSAPP_VERIFY_TOKEN=cambiar-este-token
# En desarrollo puede usarse el token temporal generado por Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# La app de prueba actual está configurada con Graph API v26.0.
WHATSAPP_GRAPH_API_VERSION=v26.0
# Opcional durante la prueba; recomendable en producción para validar la firma del webhook.
META_APP_SECRET=

AUTO_REPLY_ENABLED=true
HUMAN_HANDOFF_KEYWORD=humano
