APP_NAME=Micromega Inmobiliaria
APP_ENV=dev

# Arranque inmediato, sin instalar PostgreSQL:
DATABASE_URL=sqlite:///./micromega.db
# Para PostgreSQL con docker-compose:
# DATABASE_URL=postgresql+psycopg://micromega:micromega@localhost:5432/micromega

# LLM: por defecto el proyecto funciona sin clave.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# WhatsApp Cloud API / Meta. Completar cuando conectemos el número real.
WHATSAPP_VERIFY_TOKEN=cambiar-este-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# No hardcodeamos una versión de Graph API: colocar la versión vigente al configurar Meta.
WHATSAPP_GRAPH_API_VERSION=vXX.X
META_APP_SECRET=

AUTO_REPLY_ENABLED=true
HUMAN_HANDOFF_KEYWORD=humano
